{
  "name": "trade-saathi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply trade_saathi --local",
    "db:seed:local": "wrangler d1 execute trade_saathi --local --file=seed/seed.sql",
    "pages:dev": "wrangler pages dev dist"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@playwright/test": "^1.47.0",
    "@preact/preset-vite": "^2.9.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "wrangler": "^3.80.0"
  }
}
